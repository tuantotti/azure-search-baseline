AZURE_SEARCH_ENDPOINT=https://YOUR-SERVICE.search.windows.net
# Key authentication: supply a query key for search, or admin key for writes.
# Omit the key to use DefaultAzureCredential (managed identity in UAT).
AZURE_SEARCH_API_KEY=YOUR-AZURE-SEARCH-KEY
AZURE_SEARCH_API_VERSION=2025-09-01
# Select the Python embedding provider (default: azure_openai).
EMBEDDING_PROVIDER=azure_openai
# For public OpenAI set EMBEDDING_PROVIDER=openai and BOTH of these:
# OPENAI_API_KEY=YOUR-OPENAI-KEY
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI: embeddings, native summary skill, and/or agentic chat planner.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=YOUR-AZURE-OPENAI-KEY
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=YOUR-EMBEDDING-DEPLOYMENT
OPENAI_API_VERSION=2024-10-21
REQUEST_TIMEOUT_SECONDS=60
AZURE_RETRY_TOTAL=2
ROOT_PATH=
LOG_LEVEL=INFO

# Native summary skill management uses a separate stable API version.
AZURE_SEARCH_SKILL_API_VERSION=2026-04-01
# Summary skill requires AZURE_OPENAI_ENDPOINT and AZURE_OPENAI_CHAT_DEPLOYMENT.
# If AZURE_OPENAI_API_KEY is omitted, SEARCH SERVICE managed identity calls the LLM.
# This differs from the application's DefaultAzureCredential used for embeddings.

# Agentic retrieval uses a separate preview API and chat deployment.
AZURE_SEARCH_AGENTIC_API_VERSION=2026-08-01-preview
# Set both to a supported chat deployment and its model name (not the embedding model).
# AZURE_OPENAI_CHAT_DEPLOYMENT=YOUR-CHAT-DEPLOYMENT
# AZURE_OPENAI_CHAT_MODEL=gpt-4.1-mini

# Optional billing connection for built-in skills (entities, language, key phrases, sentiment).
# Without a billing resource, Azure's limited free allowance applies.
# Setting the endpoint overrides any billing connection in cloned/advanced skillsets.
# AZURE_AI_SERVICES_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com
# AZURE_AI_SERVICES_KEY=YOUR-AI-SERVICES-KEY
# Omit the key to use the SEARCH SERVICE system-assigned managed identity.
